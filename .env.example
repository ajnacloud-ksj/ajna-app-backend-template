# ─── {{app-name}} Backend — Local Dev Environment ───────────────────────────
# Copy this file to .env and start the stack:
#     cp .env.example .env
#     ./dev.sh start                   # backend :8000, UI :5173 (auto-shifts if busy)
#     # then: ./dev.sh logs | ./dev.sh stop
# NEVER commit .env. This .env.example is committed: it contains only non-secret
# placeholders. The IBEX_API_KEY is provisioned per-app via Cockpit — fill it in.
#
# Prerequisite: clone the SDK once at ~/ajna/ibex/ajna-cloud-sdk (or ../ajna-cloud-sdk):
#     git clone git@github.com:ajnacloud-ksj/ajna-cloud-sdk.git ~/ajna/ibex/ajna-cloud-sdk
#
# Shared dev login (shared dev Cognito pool):
#     dev@ajna.cloud / $AjnaDev@2026$   ← super_admin
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
MASK_SENSITIVE_DATA=false

# ─── IbexDB (dev cluster) ──────────────────────────────────────────────────
IBEX_API_URL={{ibex-api-url}}
IBEX_API_KEY={{ibex-api-key}}
# Default/fallback tenant. Switch via this slug or the X-Tenant-ID header.
TENANT_ID={{app-name}}
DB_NAMESPACE=default

# ─── Authentication (shared dev Cognito pool) ──────────────────────────────
AUTH_MODE=cognito
COGNITO_REGION={{aws-region}}
COGNITO_USER_POOL_ID={{cognito-user-pool-id}}
COGNITO_CLIENT_ID={{cognito-client-id}}

# ─── App config ──────────────────────────────────────────────────────────────
# APP_PREFIX lets the SDK resolve a user's tenant from their Cognito group
# ({{app-name}}-{tenant}-{role}). Must match the deployed value.
APP_PREFIX={{app-name}}
AWS_REGION={{aws-region}}

# ─── Feature flags / SDK toggles ───────────────────────────────────────────
FEATURE_ITEMS_CRUD=true
IBEX_AUDIT_ENABLED=true
IBEX_RBAC_ENABLED=true

# Leave unset in local dev — the SDK reflects the caller's origin automatically.
# CORS_ALLOWED_ORIGINS=
PORT=8000
