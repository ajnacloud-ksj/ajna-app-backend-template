# ─── {{app-name}} Backend — Local Dev Environment ───────────────────────────
# Copy this file to .env and start the stack:
#     cp .env.example .env
#     ./dev.sh start                   # backend :8000, UI :5173 (auto-shifts if busy)
#     # then: ./dev.sh logs | ./dev.sh stop
# NEVER commit .env. This .env.example is committed: it contains only non-secret
# placeholders.
#
# No IbexDB key: the SDK (ajna-cloud 4.x) is token only. Each data call carries a short session
# token for one actor (a signed-in person, a job, a webhook connection), issued against the app's
# AWS workload proof. Do not add a data-service key or AJNA_DATA_TOKEN: the SDK reads neither.
#
# Prerequisite: clone the SDK once at ~/ajna/ibex/ajna-cloud-sdk (or ../ajna-cloud-sdk):
#     git clone git@github.com:ajnacloud-ksj/ajna-cloud-sdk.git ~/ajna/ibex/ajna-cloud-sdk
#
# Sign-in: people sign in at the platform portal; the app never sees a password. Local dev
# (default): ./dev.sh starts the ajna-cloud-bricks Keycloak kit and WRITES the login settings into
# .env itself (AJNA_LOGIN_ADAPTER=oidc, AUTH_MODE=oidc, AJNA_LOGIN_OIDC_ISSUER/_AUDIENCE, the
# local CA bundle). Do not add them here. Test persons: ./dev.sh login <person> (README).
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
MASK_SENSITIVE_DATA=false

# ─── IbexDB (dev cluster) ──────────────────────────────────────────────────
IBEX_API_URL={{ibex-api-url}}
# Default/fallback tenant. Switch via this slug or the X-Tenant-ID header.
TENANT_ID={{app-name}}
DB_NAMESPACE=default
# Data area: per-app keeps this app's tenant data in {tenant}_{app namespace}, not in the
# shared {tenant}_default. New apps are per-app in dev and prod (cockpit default), so local
# dev uses it too. The app namespace comes from APP_NAME (the cockpit app name), else
# APP_PREFIX. Do not change this for an app that already has data in the shared area.
# Per-app also stores this app's roles app-scoped (<app>.admin); leave AJNA_APP_SCOPED_ROLES
# unset (there is no "off").
AJNA_DATA_AREA=per-app
APP_NAME={{app-name}}

# ─── Authentication: mode 2 (AJNA_LOCAL_SIGNIN=dev, end to end against dev) ───
# The shared dev Cognito pool. The SDK reads it to VERIFY session tokens; nothing here signs
# anyone in. Kept because mode 2 (MFA, invite, forgot flows through the dev platform sign-in)
# needs it. With the default Keycloak mode, dev.sh sets AUTH_MODE=oidc and these are not read.
AUTH_MODE=cognito
COGNITO_REGION={{aws-region}}
COGNITO_USER_POOL_ID={{cognito-user-pool-id}}
COGNITO_CLIENT_ID={{cognito-client-id}}

# ─── App config ──────────────────────────────────────────────────────────────
# APP_PREFIX lets the SDK resolve a user's tenant from their Cognito group
# ({{app-name}}-{tenant}-{role}). Must match the deployed value.
APP_PREFIX={{app-name}}
AWS_REGION={{aws-region}}

# ─── Feature flags / SDK toggles ───────────────────────────────────────────
FEATURE_ITEMS_CRUD=true
IBEX_AUDIT_ENABLED=true
IBEX_RBAC_ENABLED=true

# Leave unset in local dev — the SDK reflects the caller's origin automatically.
# CORS_ALLOWED_ORIGINS=
PORT=8000
